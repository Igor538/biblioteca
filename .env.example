# ==========================================================
# Exemplo de configuração — copie para .env e preencha
# NUNCA versione o arquivo .env real.
# ==========================================================

# ---------- Banco de dados ----------
# PostgreSQL (Neon, Supabase, RDS etc.)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
DB_POOL_SIZE=5

# ---------- Aplicação ----------
# producao | desenvolvimento
APP_ENV=desenvolvimento

# URL pública usada em links de e-mail e validação de Origin.
APP_BASE_URL=http://localhost:5000

# Obrigatório em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Tempo de vida da sessão (horas).
SESSION_HORAS=8

# true quando servido por HTTPS (cookies Secure + HSTS).
SESSION_COOKIE_SECURE=false

# true somente atrás de proxy reverso confiável (usa X-Forwarded-For).
TRUST_PROXY=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Servidor de desenvolvimento
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# Mostra o link de recuperação no console (apenas desenvolvimento).
MOSTRAR_LINK_RECUPERACAO=false

# ---------- Contas de gestão iniciais ----------
# Usadas apenas quando a conta ainda não existe no banco.
# Vazio = senhas de teste em desenvolvimento (admin / biblioteca).
# Em produção (APP_ENV=production) estes valores são obrigatórios.
ADMIN_EMAIL=admin@biblioteca.local
ADMIN_SENHA=
BIB_EMAIL=bibliotecaria@biblioteca.local
BIB_SENHA=

# ---------- E-mail (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@biblioteca.local
EMAIL_FROM_NAME=Biblioteca Digital
